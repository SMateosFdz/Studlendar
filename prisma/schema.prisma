// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id       String    @id @default(auto()) @map("_id") @db.ObjectId
  nameUser String    @unique
  email String @unique
  password String
  preferences Json? 
  subjects  Subject[]
}

model Subject {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  author      User     @relation(fields: [authorId], references: [nameUser])
  authorId    String @unique
  name        String @unique
  hours String
  sessionSize    String
  sessionOrg  String
  initialDate DateTime
  endDate     DateTime
  StudyBlock StudyBlock[]
  ClassBlock ClassBlock[]
  Event Event[]
}

model StudyBlock {
  id          String   @id @map("_id")
  subject Subject @relation(fields: [subjectId], references: [id])
  subjectId String @db.ObjectId
  subjectName String
  blockId String @unique
  name String
  time String
  date DateTime
  notes String
  repetition String
  completed Int
}

model ClassBlock {
  id          String   @id @map("_id")
  subject Subject @relation(fields: [subjectId], references: [id])
  subjectId String @db.ObjectId
  subjectName String 
  blockId String
  name String
  time String
  date DateTime
  notes String
  repetition String
  completed Int
}

model Event {
  id          String   @id @map("_id")
  subject Subject @relation(fields: [subjectId], references: [id])
  subjectId String @db.ObjectId
  subjectName String
  blockId String
  name String
  color String
  date DateTime
  notes String
  completed Boolean
}
